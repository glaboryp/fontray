{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.vue --fix",
        "lint:check": "eslint resources/js --ext .js,.vue",
        "format": "prettier --write \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.css\"",
        "format:check": "prettier --check \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.css\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "happy-dom": "^20.14.5",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.8",
        "serverless": "^4.42.0",
        "serverless-lift": "^1.37.7",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "axios": "^1.20.0",
        "vue": "^3.5.43",
        "vue-advanced-cropper": "^2.8.9"
    }
}
