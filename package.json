{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.vue --fix",
        "lint:check": "eslint resources/js --ext .js,.vue",
        "format": "prettier --write \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.css\"",
        "format:check": "prettier --check \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.css\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.4",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "happy-dom": "^21.0.4",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.9.10",
        "serverless": "^4.46.0",
        "serverless-lift": "^1.37.10",
        "tailwindcss": "^4.3.4",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "axios": "^1.21.0",
        "vue": "^3.5.45",
        "vue-advanced-cropper": "^2.8.9"
    }
}
